  "User": {
    "added_properties": {},
    "removed_properties": {},
    "modified_properties": {
      "is_active": {
        "before": {
          "type": "boolean",
          "default": true,
          "description": "Master access toggle."
        },
        "after": {
          "type": "boolean",
          "default": true,
          "description": "Master access toggle.",
          "rls": {
            "update": {
              "user_condition": {
                "collaborator_role": "editor"
              }
            }
          }
        }
      },
      "org_access": {
