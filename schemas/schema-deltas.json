        },
        "after": {
          "type": "string",
          "description": "SHA-256 hash of the contract PDF content at confirmation time"
        }
      },
      "signed_at": {
        "before": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the e-signature"
        },
        "after": {
          "type": "string",
          "format": "date-time",
          "description": "When the signature was confirmed"
        }
      },
      "signature_method": {
        "before": {
          "type": "string",
          "enum": [
            "e_sign",
            "manual_signed",
            "revert_signed"
          ],
          "description": "How the action was recorded: native e-sign, manual signature override, or a signature revert."
        },
        "after": {
          "type": "string",
          "enum": [
            "e_sign",
            "manual_signed",
            "revert_signed",
            "staff_confirmation"
          ],
          "description": "Historical e_sign entries are retained; new internal confirmations are staff_confirmation."
        }
      }
    },
    "required_before": [
      "contract_id",
      "user_id",
      "contract_hash",
      "action",
      "signed_at"
    ],
    "required_after": [
      "contract_id",
      "user_id",
      "contract_hash",
      "action",
      "signed_at"
    ],
    "rls_before": null,
    "rls_after": {
      "read": {
        "$or": [
          {
            "user_condition": {
              "role": "admin"
            }
          },
          {
            "data.user_id": "{{user.id}}"
          }
        ]
      },
      "create": {
        "user_condition": {
          "collaborator_role": "editor"
        }
      },
      "update": {
        "user_condition": {
          "collaborator_role": "editor"
        }
      },
      "delete": {
        "user_condition": {
          "collaborator_role": "editor"
        }
      }
    }
  },
