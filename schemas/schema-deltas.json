          "default": [
            "analog"
          ],
          "description": "Organizations this user may access."
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "elevate",
              "analog"
            ]
          },
          "default": [
            "analog"
          ],
          "description": "Organizations this user may access.",
          "rls": {
            "update": {
