+export async function buildContractDocument(source) {
+  const { template, fields, breakdown } = source;
+  const entry = getTemplate(template.template_key);
+  const { ctx } = buildScheduleContext({ f: fields, breakdown, templateKey: template.template_key });
+  const { html } = renderContractDocument(template.template_key, ctx);
+  let slot = 0;
+  const blocks = [...html.matchAll(/<!--block:([^:]+):(clause|appendix|protected|economics)-->([\s\S]*?)<!--\/block-->/g)].map((m, order) => {
+    const locked = ['protected','economics'].includes(m[2]);
+    const rawHtml = m[3].trim().startsWith('<') ? m[3].trim() : `<p>${m[3].trim()}</p>`;
+    const rich_text = locked ? rawHtml : safeRichText(rawHtml.replace(/<p class="[^"]*strong[^"]*">([\s\S]*?)<\/p>/g, '<p><strong>$1</strong></p>').replace(/<h2[^>]*>([\s\S]*?)<\/h2>/g, '<p><strong>$1</strong></p>').replace(/<div[^>]*>([\s\S]*?)<\/div>/g, '<p>$1</p>'));
+    const block = { id: m[1], kind: m[2], order, slot, rich_text, baseline_html: rich_text, baseline_text: rich_text.replace(/<[^>]*>/g, '').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"'), master: true };
+    if (locked) slot++;
+    return block;
+  });
+  const reference = buildScheduleContext({ f: { contract_date: '2000-01-01', artist_name: '{{artist}}', agency_name: '{{agency}}' }, breakdown: null, templateKey: template.template_key });
+  const renderedReference = renderContractDocument(template.template_key, reference.ctx);
+  const master_content_version = await contentHash({ brand: entry.brand, pack: entry.pack, billingPositionSentence: entry.pack.billingPositionSentence('{{artist}}', '{{position}}'), protectedText: [AESL_REPRESENTATION_EN, AESL_REPRESENTATION_ES], banner: ANALOG_BANNER_URL, styles: CONTRACT_CSS, config: CONTRACT_RENDER_CONFIG, renderedReference, version: 'block-markers-v2' });
+  return { show_id: source.show.id, contract_id: source.show.contract_id || null, template_id: template.id, template_key: template.template_key, legal_entity_id: source.legalEntity.id, source_snapshot: source, master_content_version, blocks, content_hash: await contentHash(blocks), revision_no: 0, parent_draft_id: null, status: 'editing', lock_token: crypto.randomUUID(), required_inputs: [] };
+}
+function safeRichText(html) {
+  if (typeof html !== 'string' || html.length > 24000) throw new AccessError('Clause content is too large', 422);
+  if (/<\s*(script|style|iframe|object|svg|math)\b/i.test(html)) throw new AccessError('Unsupported rich-text content', 422);
+  return html.replace(/<\/?([a-z][a-z0-9]*)\b[^>]*>/gi, (tag, name) => {
+    if (!['p','br','strong','b','em','i','u','ol','ul','li','span'].includes(name.toLowerCase())) throw new AccessError('Only paragraphs, bold, italic, underline and lists are allowed', 422);
+    return `<${tag.startsWith('</') ? '/' : ''}${name.toLowerCase()}>`;
+  });
+}
+export function validateDraftBlocks(candidate, master) {
+  if (!Array.isArray(candidate) || candidate.length > 120 || JSON.stringify(candidate).length > 250000) throw new AccessError('Invalid document blocks', 422);
+  const originals = new Map(master.map(b => [b.id,b]));
+  const ids = new Set(); let slot = 0;
+  const protectedIds = master.filter(b => ['protected','economics'].includes(b.kind)).map(b=>b.id); let protectedIndex=0;
+  const blocks = candidate.map((b,order) => {
+    if (!b || typeof b.id !== 'string' || ids.has(b.id)) throw new AccessError('Invalid or duplicate block id',422);
+    ids.add(b.id); const original=originals.get(b.id);
+    if (original && ['protected','economics'].includes(original.kind)) {
+      if (b.id!==protectedIds[protectedIndex++] || b.kind!==original.kind || b.rich_text!==original.rich_text || b.slot!==slot) throw new AccessError('Protected blocks cannot be edited, removed or reordered',422);
+      slot++; return {...original,order};
+    }
+    if (!['clause','appendix'].includes(b.kind) || b.slot!==slot || (original && (original.kind!==b.kind || original.slot!==slot))) throw new AccessError('Editable blocks must stay within their protected section',422);
+    if (!original && !/^custom-[a-z0-9-]+$/i.test(b.id)) throw new AccessError('Invalid inserted block id',422);
+    const rich_text=safeRichText(b.rich_text);
+    return {id:b.id,kind:b.kind,order,slot,rich_text,baseline_html:original?.baseline_html||'',baseline_text:original?.baseline_text||'',master:!!original};
+  });
+  if(protectedIndex!==protectedIds.length) throw new AccessError('All protected blocks must remain',422);
+  return blocks;
+}
