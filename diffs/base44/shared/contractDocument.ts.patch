+export async function contentHash(value) {
+  const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(JSON.stringify(value)));
+  return [...new Uint8Array(digest)].map(x => x.toString(16).padStart(2, '0')).join('');
+}
+export async function draftAccess(base44, user, showId) {
+  if (!user || user.is_active === false) throw new AccessError('Active account required', 403);
+  const { show } = await assertShowAccess(base44, showId, user);
+  if (!await canDispatchContracts(base44, user, show)) throw new AccessError('Only the show creator, assigned logistics agents, or Admin/Finance can edit contract drafts', 403);
+  return show;
+}
+export async function loadContractSource(base44, show, templateId, fields = {}) {
+  const svc = base44.asServiceRole.entities;
+  if ('contract_date' in fields) validDate(fields.contract_date, 'Contract date');
