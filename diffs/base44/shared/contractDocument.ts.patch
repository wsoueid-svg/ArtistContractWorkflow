+  const legalEntity = await svc.LegalEntity.get(template.legal_entity_id);
+  if (!legalEntity?.is_active) throw new AccessError('Template Legal Entity is unavailable', 422);
+  if ((show.status === 'completed' || show.legal_entity_locked_at) && show.legal_entity_id !== legalEntity.id) throw new AccessError('Show Legal Entity binding is locked', 409);
+  const contactId = show.contract_contact_id || show.client_contact_id || show.contact_id;
+  if (!contactId) throw new AccessError('Link a promoter Contact before opening the document', 422);
+  const [artist, contact] = await Promise.all([svc.Artist.get(show.artist_id), svc.Contact.get(contactId)]);
+  if (!contact || contact.is_deleted) throw new AccessError('Promoter Contact is unavailable', 422);
+  const currency = String(show.currency || legalEntity.default_currency || 'EUR').toUpperCase();
+  if (fields.currency && String(fields.currency).toUpperCase() !== currency) throw new AccessError('Contract currency must match Show currency', 422);
+  if (!(legalEntity.allowed_currencies?.length ? legalEntity.allowed_currencies : [legalEntity.default_currency || 'EUR']).includes(currency)) throw new AccessError('Show currency is not allowed by the Legal Entity', 422);
+  const allowed = ['company_name','company_address','company_vat','company_signatory','agency_signatory','contract_date','deposit_month','billing_requirements','billing_position','contract_notes'];
+  const submitted = Object.fromEntries(allowed.filter(k => fields[k] != null && fields[k] !== '').map(k => [k, String(fields[k]).slice(0, 8000)]));
+  const f = { contract_date: new Date().toISOString().slice(0,10), company_name: contact.default_deal_terms?.legal_company_name || contact.company || contact.name, company_address: [contact.default_deal_terms?.billing_address?.street || contact.billing_address?.street || contact.address, contact.default_deal_terms?.billing_address?.city || contact.billing_address?.city || contact.city, contact.default_deal_terms?.billing_address?.postal_code || contact.billing_address?.postal_code, contact.default_deal_terms?.billing_address?.country || contact.billing_address?.country || contact.country].filter(Boolean).join(', '), company_vat: contact.vat_tax_id || '', company_signatory: contact.name, billing_requirements: show.offer_details?.exclusivity || 'A-Z', billing_position: 'A-Z', contract_notes: show.contract_notes || '', ...submitted, currency, artist_name: artist.name, event_name: show.event_name, venue: show.venue, country: show.country, date_of_show: show.date, timing: getContractualSetWindow(show), agency_name: legalEntity.name, agency_address: [legalEntity.registered_address?.street, legalEntity.registered_address?.city, legalEntity.registered_address?.postal_code, legalEntity.registered_address?.country || legalEntity.country].filter(Boolean).join(', '), agency_rut: legalEntity.tax_id, agency_signatory: template.agency_signatory_name || 'Luis Honrado' };
+  validateShowInputs(show, template);
+  const breakdown = computeDealBreakdown({ show, legalEntity, contact, depositPct: template.default_terms?.deposit_percentage ?? show.deposit_percentage, balanceDueOffsetDays: template.default_terms?.balance_due_offset_days ?? show.balance_due_offset_days });
+  f.wht_rate = breakdown.whtRate;
+  f.advance_pct = breakdown.depositPct; f.balance_pct = 100 - breakdown.depositPct;
+  f.booking_fee = breakdown.bookingFeeCents / 100;
+  const deposit = breakdown.parts.find(part => part.type === 'DEPOSIT');
+  const balance = breakdown.parts.find(part => part.type === 'BALANCE');
+  const booking = breakdown.parts.find(part => part.type === 'BOOKING_FEE');
+  f.advance_amount = (deposit?.feeCents || 0) / 100; f.balance_amount = (balance?.feeCents || 0) / 100;
+  f.advance_due = String(deposit?.dueDate || '').split('T')[0]; f.balance_due = String(balance?.dueDate || '').split('T')[0]; f.booking_fee_due = String(booking?.dueDate || '').split('T')[0];
