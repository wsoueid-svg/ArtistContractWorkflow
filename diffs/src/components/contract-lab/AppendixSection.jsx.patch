+  const [addOpen,setAddOpen]=useState(false),[name,setName]=useState(''),[source,setSource]=useState('blank');
+  const appendices=editor.doc.blocks.filter(b=>b.kind==='appendix'),prefs=editor.doc.source_snapshot?.artist?.preferences||{};
