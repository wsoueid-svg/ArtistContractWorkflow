+import { LockKeyhole } from 'lucide-react';
+import contractPreviewUrl from '@/components/contracts/contractPreviewUrl';
+import { Link } from 'react-router-dom';
+import { Button } from '@/components/ui/button';
+import DealStatusBadge from '@/components/shared/DealStatusBadge';
+import GenerateContractButton from '@/components/shows/GenerateContractButton';
+import { formatTime } from '@/components/contract-lab/documentText';
+import ContractNextStep from '@/components/contract-lab/ContractNextStep';
+export default function CurrentRevisionCard({show,current,draft,onEdit,onGenerate,onAmend,onChanged,busy,error}) {
+  const pending=draft&&!['generated','generating'].includes(draft.status)&&(!current||draft.parent_draft_id===current.draft_id||draft.contract_id===current.id);
+  const signed=current?.status==='SIGNED',locked=current?.status==='DISPATCHING'||!!current?.dispatch_lock||!!current?.generation_lock||draft?.status==='generating';
+  const issued=['SENT','RETURNED'].includes(current?.status);
+  return <section className="rounded-lg border border-border bg-card p-4 sm:p-6" data-testid="current-contract-revision"><div className="flex flex-wrap items-start justify-between gap-4"><div className="min-w-0"><p className="text-sm font-medium text-muted-foreground">{current?(['SENT','RETURNED','SIGNED'].includes(current.status)?'Current issued revision':'Current generated revision'):'Current draft'}</p><div className="mt-2 flex flex-wrap items-center gap-2"><h2 className="text-lg font-semibold">Revision {current?.version_number||draft?.target_contract_version||1}</h2>{current?<DealStatusBadge kind="contract" status={current.status} size="sm"/>:<span className="text-xs text-muted-foreground">{draft?.status==='approved'?'Approved draft':'Not generated'}</span>}</div>{(current||draft)&&<p className="mt-2 text-xs leading-relaxed text-muted-foreground">{(current?.approved_at||draft?.approved_at)?<>Approved by {current?.approved_by_name||draft?.approved_by_name||'Name unavailable'}<br/>{formatTime(current?.approved_at||draft?.approved_at)}<br/></>:null}{current?.generated_at?`Generated ${formatTime(current.generated_at)}`:current?.contract_file_url?'Saved PDF available':'PDF not generated yet'}</p>}{pending&&current&&<p className="mt-2 text-sm">Draft for revision {draft.target_contract_version} • {draft.status==='approved'?'Saved and approved':'Editing'}</p>}<ContractNextStep current={current} draft={draft} pending={pending} locked={locked}/></div>
+    <div className="flex flex-wrap items-center gap-2">{current?.contract_file_url&&<Button asChild variant="outline"><Link to={contractPreviewUrl(current.id)}>Open PDF</Link></Button>}{current?.status==='READY'&&!pending&&!locked&&current.draft_id&&<Button variant="outline" onClick={()=>onAmend(current)}>Edit / revise contract</Button>}{current?.needs_resend&&current.status==='READY'&&<span className="text-sm text-muted-foreground">Revised PDF • needs sending</span>}{pending&&draft.status==='approved'&&!signed&&!locked&&<Button variant="ghost" onClick={()=>onEdit(draft)}>Review / edit draft</Button>}
+      {signed?<span className="inline-flex min-h-11 items-center gap-2 text-sm"><LockKeyhole className="h-4 w-4"/>Signed, locked</span>:locked?<Button disabled>In progress, locked</Button>:pending?<Button disabled={busy} onClick={()=>draft.status==='approved'?onGenerate(draft):onEdit(draft)}>{busy?'Generating…':draft.status==='approved'?'Generate PDF':'Continue editing draft'}</Button>:issued?<Button disabled={!current.draft_id} onClick={()=>onAmend(current)}>{current.draft_id?'Create Amendment':'No editable document'}</Button>:current?.status==='READY'?<GenerateContractButton primaryOnly show={{...show,contract_id:current.id,contract_url:current.contract_file_url}} contractId={current.id} contract={current} onChanged={onChanged}/>:<Button onClick={()=>onEdit(null)}>Create contract</Button>}
+    </div></div>{error&&<p className="mt-3 text-sm text-destructive" role="alert">{error}</p>}
+  </section>;
+}
