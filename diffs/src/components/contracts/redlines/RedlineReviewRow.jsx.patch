+import { useState } from 'react';
+import { base44 } from '@/api/base44Client';
+import { Button } from '@/components/ui/button';
+import { Textarea } from '@/components/ui/textarea';
+import { formatTime } from '@/components/contract-lab/documentText';
+import contractError from '@/components/contract-lab/contractErrors';
+import RedlineFileDialog from '@/components/contracts/redlines/RedlineFileDialog';
+export default function RedlineReviewRow({record,readOnly,onChanged}) {
+  const [status,setStatus]=useState(record.review_status),[notes,setNotes]=useState(record.review_notes||''),[busy,setBusy]=useState(false),[error,setError]=useState(''),[open,setOpen]=useState(false);
+  const save=async e=>{e.preventDefault();setBusy(true);setError('');try{await base44.functions.invoke('contractRedlines',{action:'review',show_id:record.show_id,redline_id:record.id,expected_review_revision:record.review_revision,review_status:status,review_notes:notes});await onChanged();}catch(e){setError(contractError(e));}finally{setBusy(false);}};
+  return <li className="space-y-3 border-t border-border py-4" data-testid={`redline-${record.id}`}><div className="flex flex-wrap items-start justify-between gap-3"><div className="min-w-0"><h3 className="break-all text-sm font-semibold">{record.file_name}</h3><p className="mt-1 text-xs text-muted-foreground">Version {record.version_number} • {record.review_status} • {record.uploaded_by_name} • {formatTime(record.created_date)}</p>{record.reviewed_at&&<p className="mt-1 text-xs text-muted-foreground">Reviewed by {record.reviewed_by_name} • {formatTime(record.reviewed_at)}</p>}</div><Button variant="outline" onClick={()=>setOpen(true)}>Open redline</Button></div>{readOnly?<p className="whitespace-pre-wrap break-words text-sm">{record.review_notes}</p>:<form onSubmit={save} className="space-y-3"><label className="block text-sm" htmlFor={`review-status-${record.id}`}>Review status</label><select id={`review-status-${record.id}`} value={status} onChange={e=>setStatus(e.target.value)} disabled={busy} className="min-h-11 w-full rounded-md border border-input bg-background px-3 text-sm">{[['pending','Pending review'],['reviewed','Reviewed'],['incorporated','Changes incorporated'],['declined','Changes declined']].map(([value,label])=><option key={value} value={value}>{label}</option>)}</select><label className="block text-sm" htmlFor={`review-notes-${record.id}`}>Review notes</label><Textarea id={`review-notes-${record.id}`} value={notes} onChange={e=>setNotes(e.target.value)} maxLength={8000} disabled={busy} placeholder="Record what was agreed and the revision containing the changes."/><p className="text-xs text-muted-foreground">Review status is a record of your decision. Incorporate agreed wording in the contract editor; this file never replaces the contract.</p><Button type="submit" variant="outline" disabled={busy||status===record.review_status&&notes===(record.review_notes||'')}>{busy?'Saving review…':'Save review'}</Button></form>}{error&&<p role="alert" className="text-sm text-destructive">{error}</p>}{open&&<RedlineFileDialog record={record} onClose={()=>setOpen(false)}/>}</li>;
+}
